# Per-operator generated files (regenerated by scripts/generate-policy.sh)

# Per-operator cron logs

# Pyramid raw transcripts (summaries + metadata committed; transcripts not)
.ai/turns/*/transcript.md
.ai/turns/*/transcript.log

# Per-operator backup files from sed
*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
/build/          # root-level Python build dir only — NOT software_factory/build/
/dist/
.venv/
.factory-worktrees/

# Per-instance manifest (may reference internal repos/paths; example is committed)
factory.config.yaml
factory.config.yml
factory.config.json

# Factory baseline/state store (when kept inside the repo)
.software-factory-state/

# OS
.DS_Store
.playwright-mcp/
.factory/          # run locks
.claude/worktrees/     # agent isolation worktrees

# setuptools output — committed by accident once; never again.
# Root-anchored: a bare `build/` also matches software_factory/build/,
# which would silently drop the whole build orchestrator package.
/build/
*.egg-info/
